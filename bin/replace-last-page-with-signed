#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 2 ]]; then
    echo "Usage: $(basename "$0") <full.pdf> <signed-last-page.pdf>" >&2
    exit 1
fi

full_pdf="$1"
signed_page="$2"

if [[ ! -f "$full_pdf" ]]; then
    echo "Error: '$full_pdf' not found" >&2
    exit 1
fi

if [[ ! -f "$signed_page" ]]; then
    echo "Error: '$signed_page' not found" >&2
    exit 1
fi

page_count=$(pdftk "$full_pdf" dump_data | grep NumberOfPages | awk '{print $2}')
last_content_page=$((page_count - 1))

base="${full_pdf%.pdf}"
output="${base}-signed.pdf"
tmp_first="$(mktemp /tmp/first-pages-XXXXXX.pdf)"

trap 'rm -f "$tmp_first"' EXIT

pdftk "$full_pdf" cat 1-"$last_content_page" output "$tmp_first"
pdftk "$tmp_first" "$signed_page" cat output "$output"

echo "Created: $output"
