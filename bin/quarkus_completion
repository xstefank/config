  type compopt &>/dev/null && compopt +o default

  case ${prev_word} in
    --config)
      return
      ;;
    -o|--output-directory)
      return
      ;;
    -x|--extension|--extensions)
      return
      ;;
    --name)
      return
      ;;
    --description)
      return
      ;;
    -S|--stream)
      return
