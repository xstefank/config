  if CompWordsContainsArray "${cmds6[@]}"; then _picocli_quarkus_extension; return $?; fi
  if CompWordsContainsArray "${cmds5[@]}"; then _picocli_quarkus_config; return $?; fi
  if CompWordsContainsArray "${cmds4[@]}"; then _picocli_quarkus_test; return $?; fi
  if CompWordsContainsArray "${cmds3[@]}"; then _picocli_quarkus_run; return $?; fi
