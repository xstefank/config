#!/usr/bin/env bash

info=$(timeout 2 bluetoothctl info 2>&1)

case "$info" in
  *"No default controller"*)                 echo "OFF"; exit 0 ;;
  ""|*"DeviceSet (null)"*|*"not available"*) echo "N/A"; exit 0 ;;
esac

name=$(printf '%s\n' "$info" | awk -F': ' '/^[[:space:]]*Name: /{print $2; exit}' \
       | LC_ALL=C tr -d '\000-\037\177')
batt=$(printf '%s\n' "$info" | awk -F'[()]' '/Battery Percentage:/{print $2; exit}' \
       | LC_ALL=C tr -d '\000-\037\177')

[ -n "$name" ] || { echo "N/A"; exit 0; }

if [ -n "$batt" ]; then
  printf '%s (%s)\n' "$name" "$batt"
else
  printf '%s\n' "$name"
fi
